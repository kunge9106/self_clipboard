{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "轻贴",
  "version": "2.0.0",
  "identifier": "com.kunge.selfclipboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "轻贴",
        "width": 1060,
        "height": 690,
        "minWidth": 880,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=RendererCodeIntegrity,msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion,OptimizationGuideModelDownloading,Translate,AutofillServerCommunication,MediaRouter,DialMediaRouteProvider,WebRtcHideLocalIpsWithMdns,GlobalMediaControls,InterestFeedContentSuggestions,IdleDetection,HeavyAdPrivacyMitigations,SpeculationRulesPrefetchProxy,BackForwardCache,NetworkTimeServiceQuerying,SpellcheckService --renderer-process-limit=1 --disable-extensions --disable-component-update --disable-default-apps --disable-sync --disable-notifications --disable-background-networking --disable-client-side-phishing-detection --disable-domain-reliability --disable-speech-api --disable-breakpad --no-first-run --no-default-browser-check --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --js-flags=--max-old-space-size=64"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
