{
  "name": "self_clipboard",
  "version": "1.3.8",
  "description": "Windows 透明磨砂毛玻璃剪贴板工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "kunge9106",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.kunge9106.self_clipboard",
    "productName": "轻贴",
    "directories": {
      "output": "dist"
    },
    "compression": "maximum",
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "轻贴",
      "runAfterFinish": false
    },
    "afterPack": "scripts/afterPack.js"
  }
}